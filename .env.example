NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://intel.rizpram.cloud
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# Free-first AI routing: OPENROUTER_API_KEY is the only required AI secret.
OPENROUTER_API_KEY=
# Required for provider credentials stored in Supabase; generate 32 random bytes and base64 encode.
AI_CREDENTIAL_ENCRYPTION_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_MODEL=openrouter/free
AI_ENABLE_OPENROUTER=true
AI_ESCALATION_CONFIDENCE_THRESHOLD=0.72
AI_CONSENSUS_ON_LOW_CONFIDENCE=false
# Direct providers remain disabled until explicitly enabled and budgeted.
AI_ALLOW_PAID_PROVIDERS=false
AI_MONTHLY_BUDGET_USD=0
AI_ENABLE_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_GEMINI_MONTHLY_BUDGET_USD=0
AI_GEMINI_INPUT_USD_PER_MILLION=-1
AI_GEMINI_OUTPUT_USD_PER_MILLION=-1
AI_ENABLE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MONTHLY_BUDGET_USD=0
AI_OPENAI_INPUT_USD_PER_MILLION=-1
AI_OPENAI_OUTPUT_USD_PER_MILLION=-1
AI_ENABLE_XAI=false
XAI_API_KEY=
XAI_MODEL=
XAI_BASE_URL=https://api.x.ai/v1
AI_XAI_MONTHLY_BUDGET_USD=0
AI_XAI_INPUT_USD_PER_MILLION=-1
AI_XAI_OUTPUT_USD_PER_MILLION=-1
AI_ENABLE_CUSTOM=false
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
AI_CUSTOM_MONTHLY_BUDGET_USD=0
AI_CUSTOM_INPUT_USD_PER_MILLION=-1
AI_CUSTOM_OUTPUT_USD_PER_MILLION=-1
# Existing OpenAI-compatible gateway may be configured as the custom provider.
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
WORKER_POLL_SECONDS=10
DEMO_MODE=true
